# Copie este arquivo para .env e preencha com os dados da sua instância.
# O arquivo .env fica fora do Git (veja .gitignore).
# Placeholders abaixo mantêm a demonstração Python e o pytest no SQLite.

# sqlite | oracle | auto
FARMTECH_DB_ENGINE=sqlite

ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_HOST=oracle.fiap.com.br
ORACLE_PORT=1521
ORACLE_SERVICE=ORCL

# Docker Desktop, imagem gvenzl/oracle-xe:21-slim:
#   ORACLE_HOST=localhost
#   ORACLE_SERVICE=XEPDB1
# Docker Desktop, imagem gvenzl/oracle-free:23-slim:
#   ORACLE_HOST=localhost
#   ORACLE_SERVICE=FREEPDB1
